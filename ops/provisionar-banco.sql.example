-- Execute como DBA no ambiente autorizado, após preencher as senhas.
CREATE DATABASE IF NOT EXISTS atlas_estoque CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS 'atlas_app'@'%' IDENTIFIED BY 'TROQUE_SENHA_APLICACAO';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES ON atlas_estoque.* TO 'atlas_app'@'%';
