// Schema Prisma — ERP Atlas Stock
// Prisma 7 + driver adapter mariadb. O datasource NÃO tem `url`: a conexão
// vive em prisma.config.ts. O client é gerado em ./generated/prisma.
//
// O schema evolui por fase (migração incremental do sistema PHP legado):
//   Fase 1: autenticação + cadastros.
//   Fase 2: compras + despesas vinculadas.
//   Fase 3: projetos de blindagem.
//   Fase 4 (esta): financeiro completo + dashboard.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Cargo {
  ADMINISTRADOR
  GERENTE
  OPERADOR
}

enum ClienteTipo {
  PF
  PJ
}

enum ProdutoEscopo {
  GERAL
  PROJETO
}

enum MovimentacaoTipo {
  ENTRADA
  SAIDA
}

enum CompraStatus {
  A_PAGAR
  CONFIRMADA
  PAGO
  CANCELADA
}

enum DespesaStatus {
  A_PAGAR
  PAGO
  CANCELADA
}

enum ReceitaStatus {
  A_RECEBER
  RECEBIDO
}

enum ProjetoStatus {
  AGUARDANDO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum ProjetoConsumoTipo {
  PRODUTO
  SERVICO
}

// ───────────────────────────── Autenticação ──────────────────────────

model Usuario {
  id               Int      @id @default(autoincrement())
  nome             String   @db.VarChar(150)
  email            String   @unique @db.VarChar(180)
  senha            String   @map("senha") @db.VarChar(255) // hash bcrypt
  cargo            Cargo    @default(OPERADOR)
  ativo            Boolean  @default(true)
  /// Permissão financeira explícita. Só vale para GERENTE: administrador
  /// sempre tem acesso e operador nunca tem (ver common/auth/permissoes.ts).
  acessoFinanceiro Boolean  @default(false) @map("acesso_financeiro")
  createdAt        DateTime @default(now()) @map("criado_em")
  updatedAt        DateTime @updatedAt @map("atualizado_em")

  movimentacoes    Movimentacao[]
  refreshTokens    RefreshToken[]
  sessoes          Sessao[]
  recuperacoes     RecuperacaoSenha[]
  mfaSegredo       String?            @map("mfa_segredo") @db.Text
  mfaAtivo         Boolean            @default(false) @map("mfa_ativo")
  mfaUltimoPasso   Int                @default(0) @map("mfa_ultimo_passo")
  mfaRecuperacao   Json?              @map("mfa_recuperacao")
  compras          Compra[]
  projetos         Projeto[]
  projetoHistorico ProjetoHistorico[]
  projetoConsumos  ProjetoConsumo[]

  @@map("usuarios")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  sessaoId  String?   @map("sessao_id") @db.VarChar(36)
  sessao    Sessao?   @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  tokenHash String    @map("resumo_token") @db.VarChar(255)
  expiresAt DateTime  @map("expira_em")
  revokedAt DateTime? @map("revogado_em")
  createdAt DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tokenHash])
  @@index([sessaoId])
  @@map("tokens_renovacao")
}

// ─────────────────────────────── Cadastros ───────────────────────────

model Categoria {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(120)
  descricao String?  @db.Text
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id                Int           @id @default(autoincrement())
  codigo            String        @unique @db.VarChar(60)
  nome              String        @db.VarChar(200)
  descricao         String?       @db.Text
  categoriaId       Int?          @map("categoria_id")
  unidadeMedida     String        @map("unidade_medida") @db.VarChar(20)
  valorUnitario     Decimal       @default(0) @map("valor_unitario") @db.Decimal(12, 2)
  quantidadeEstoque Decimal       @default(0) @map("quantidade_estoque") @db.Decimal(12, 3)
  custoMedio        Decimal       @default(0) @map("custo_medio") @db.Decimal(12, 2)
  escopo            ProdutoEscopo @default(GERAL)
  projetoId         Int?          @map("projeto_id") // FK adicionada na fase de Projetos
  ativo             Boolean       @default(true)
  createdAt         DateTime      @default(now()) @map("criado_em")
  updatedAt         DateTime      @updatedAt @map("atualizado_em")

  categoria       Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  projeto         Projeto?         @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  movimentacoes   Movimentacao[]
  compraItens     CompraItem[]
  projetoConsumos ProjetoConsumo[]

  @@index([categoriaId])
  @@index([projetoId])
  @@index([ativo])
  @@map("produtos")
}

model Fornecedor {
  id              Int      @id @default(autoincrement())
  nomeRazaoSocial String   @map("nome_razao_social") @db.VarChar(200)
  cpfCnpj         String   @map("cpf_cnpj") @db.VarChar(20)
  telefone        String?  @db.VarChar(30)
  email           String?  @db.VarChar(180)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("criado_em")
  updatedAt       DateTime @updatedAt @map("atualizado_em")

  compras  Compra[]
  despesas Despesa[]

  @@index([ativo])
  @@map("fornecedores")
}

model Cliente {
  id           Int         @id @default(autoincrement())
  tipo         ClienteTipo @default(PF)
  nomeCompleto String      @map("nome_completo") @db.VarChar(200)
  cpfCnpj      String      @map("cpf_cnpj") @db.VarChar(20)
  telefone     String?     @db.VarChar(30)
  email        String?     @db.VarChar(180)
  cep          String?     @db.VarChar(15)
  rua          String?     @db.VarChar(200)
  numero       String?     @db.VarChar(20)
  complemento  String?     @db.VarChar(120)
  bairro       String?     @db.VarChar(120)
  cidade       String?     @db.VarChar(120)
  estado       String?     @db.VarChar(2)
  observacoes  String?     @db.Text
  ativo        Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("criado_em")
  updatedAt    DateTime    @updatedAt @map("atualizado_em")

  veiculos Veiculo[]
  projetos Projeto[]
  receitas Receita[]

  @@index([ativo])
  @@map("clientes")
}

model Veiculo {
  id                  Int      @id @default(autoincrement())
  clienteId           Int      @map("cliente_id")
  placa               String   @db.VarChar(10)
  marca               String   @db.VarChar(80)
  modelo              String   @db.VarChar(120)
  ano                 String?  @db.VarChar(10)
  cor                 String?  @db.VarChar(40)
  observacoesTecnicas String?  @map("observacoes_tecnicas") @db.Text
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("criado_em")
  updatedAt           DateTime @updatedAt @map("atualizado_em")

  cliente  Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  projetos Projeto[]

  @@index([clienteId])
  @@index([ativo])
  @@map("veiculos")
}

model Movimentacao {
  id               Int              @id @default(autoincrement())
  produtoId        Int              @map("produto_id")
  tipo             MovimentacaoTipo
  quantidade       Decimal          @db.Decimal(12, 3)
  custoUnitario    Decimal          @default(0) @map("custo_unitario") @db.Decimal(12, 2)
  valorTotal       Decimal          @default(0) @map("valor_total") @db.Decimal(12, 2)
  motivo           String?          @db.VarChar(200)
  projetoId        Int?             @map("projeto_id") // FK adicionada na fase de Projetos
  compraId         Int?             @map("compra_id")
  usuarioId        Int              @map("usuario_id")
  dataMovimentacao DateTime         @default(now()) @map("data_movimentacao")

  produto Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuario Usuario  @relation(fields: [usuarioId], references: [id])
  compra  Compra?  @relation(fields: [compraId], references: [id], onDelete: SetNull)
  projeto Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([produtoId])
  @@index([tipo])
  @@index([projetoId])
  @@index([compraId])
  @@map("movimentacoes")
}

// ─────────────────────────────── Compras ───────────────────────────

model Compra {
  id            Int          @id @default(autoincrement())
  fornecedorId  Int          @map("fornecedor_id")
  status        CompraStatus @default(A_PAGAR) @map("situacao")
  dataCompra    DateTime     @default(now()) @map("data_compra")
  dataPagamento DateTime?    @map("data_pagamento")
  valorTotal    Decimal      @default(0) @map("valor_total") @db.Decimal(12, 2)
  observacoes   String?      @db.Text
  usuarioId     Int          @map("usuario_id")
  createdAt     DateTime     @default(now()) @map("criado_em")
  updatedAt     DateTime     @updatedAt @map("atualizado_em")

  fornecedor    Fornecedor     @relation(fields: [fornecedorId], references: [id])
  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  itens         CompraItem[]
  despesa       Despesa?
  movimentacoes Movimentacao[]

  @@index([fornecedorId])
  @@index([status])
  @@index([dataCompra])
  @@map("compras")
}

model CompraItem {
  id            Int     @id @default(autoincrement())
  compraId      Int     @map("compra_id")
  produtoId     Int     @map("produto_id")
  quantidade    Decimal @db.Decimal(12, 3)
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(12, 2)
  valorTotal    Decimal @map("valor_total") @db.Decimal(12, 2)

  compra  Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([compraId])
  @@index([produtoId])
  @@map("itens_compras")
}

// Despesa vinculada a compra ou avulsa; módulo financeiro completo na Fase 4.
model Despesa {
  id                 Int           @id @default(autoincrement())
  descricao          String        @db.VarChar(200)
  valor              Decimal       @db.Decimal(12, 2)
  status             DespesaStatus @default(A_PAGAR) @map("situacao")
  dataVencimento     DateTime?     @map("data_vencimento")
  dataPagamento      DateTime?     @map("data_pagamento")
  fornecedorId       Int?          @map("fornecedor_id")
  categoriaDespesaId Int?          @map("categoria_despesa_id")
  compraId           Int?          @unique @map("compra_id")
  projetoId          Int?          @map("projeto_id")
  createdAt          DateTime      @default(now()) @map("criado_em")
  updatedAt          DateTime      @updatedAt @map("atualizado_em")

  fornecedor       Fornecedor?       @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  categoriaDespesa CategoriaDespesa? @relation(fields: [categoriaDespesaId], references: [id], onDelete: SetNull)
  compra           Compra?           @relation(fields: [compraId], references: [id], onDelete: Cascade)
  projeto          Projeto?          @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([categoriaDespesaId])
  @@index([projetoId])
  @@map("despesas")
}

// ─────────────────────────────── Projetos ──────────────────────────

model Projeto {
  id            Int           @id @default(autoincrement())
  clienteId     Int           @map("cliente_id")
  veiculoId     Int           @map("veiculo_id")
  status        ProjetoStatus @default(AGUARDANDO) @map("situacao")
  descricao     String?       @db.Text
  valorOrcado   Decimal       @default(0) @map("valor_orcado") @db.Decimal(12, 2)
  valorFinal    Decimal?      @map("valor_final") @db.Decimal(12, 2)
  dataInicio    DateTime?     @map("data_inicio")
  dataConclusao DateTime?     @map("data_conclusao")
  usuarioId     Int           @map("usuario_id")
  ativo         Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("criado_em")
  updatedAt     DateTime      @updatedAt @map("atualizado_em")

  cliente       Cliente                @relation(fields: [clienteId], references: [id])
  veiculo       Veiculo                @relation(fields: [veiculoId], references: [id])
  usuario       Usuario                @relation(fields: [usuarioId], references: [id])
  checklist     ProjetoChecklistItem[]
  historico     ProjetoHistorico[]
  consumos      ProjetoConsumo[]
  produtos      Produto[]
  movimentacoes Movimentacao[]
  receitas      Receita[]
  despesas      Despesa[]

  @@index([clienteId])
  @@index([veiculoId])
  @@index([status])
  @@index([ativo])
  @@map("projetos")
}

model ProjetoChecklistItem {
  id          Int       @id @default(autoincrement())
  projetoId   Int       @map("projeto_id")
  descricao   String    @db.VarChar(300)
  concluido   Boolean   @default(false)
  ordem       Int       @default(0)
  concluidoEm DateTime? @map("concluido_em")
  createdAt   DateTime  @default(now()) @map("criado_em")
  updatedAt   DateTime  @updatedAt @map("atualizado_em")

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("itens_verificacao_projetos")
}

model ProjetoHistorico {
  id             Int            @id @default(autoincrement())
  projetoId      Int            @map("projeto_id")
  statusAnterior ProjetoStatus? @map("status_anterior")
  statusNovo     ProjetoStatus  @map("status_novo")
  observacao     String?        @db.Text
  usuarioId      Int            @map("usuario_id")
  createdAt      DateTime       @default(now()) @map("criado_em")

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([projetoId])
  @@map("historicos_projetos")
}

model ProjetoConsumo {
  id            Int                @id @default(autoincrement())
  projetoId     Int                @map("projeto_id")
  tipo          ProjetoConsumoTipo @default(PRODUTO)
  produtoId     Int?               @map("produto_id")
  descricao     String?            @db.VarChar(200)
  quantidade    Decimal            @db.Decimal(12, 3)
  valorUnitario Decimal            @map("valor_unitario") @db.Decimal(12, 2)
  valorTotal    Decimal            @map("valor_total") @db.Decimal(12, 2)
  usuarioId     Int                @map("usuario_id")
  createdAt     DateTime           @default(now()) @map("criado_em")

  projeto Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  usuario Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([projetoId])
  @@index([produtoId])
  @@map("consumos_projetos")
}

// ─────────────────────────────── Financeiro ────────────────────────

model CategoriaDespesa {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(120)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  despesas Despesa[]

  @@map("categorias_despesas")
}

model Receita {
  id              Int           @id @default(autoincrement())
  descricao       String        @db.VarChar(200)
  valor           Decimal       @db.Decimal(12, 2)
  status          ReceitaStatus @default(A_RECEBER) @map("situacao")
  dataVencimento  DateTime?     @map("data_vencimento")
  dataRecebimento DateTime?     @map("data_recebimento")
  clienteId       Int?          @map("cliente_id")
  projetoId       Int?          @map("projeto_id")
  createdAt       DateTime      @default(now()) @map("criado_em")
  updatedAt       DateTime      @updatedAt @map("atualizado_em")

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  projeto Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([clienteId])
  @@index([projetoId])
  @@map("receitas")
}

/// Configuração singleton do sistema.
/// `financeiroSenhaHash` não é mais usado (o acesso financeiro passou a ser
/// nominal); a coluna sai na padronização do banco, sem perder dados agora.
model ConfigSistema {
  id                  Int      @id @default(1)
  financeiroSenhaHash String?  @map("financeiro_senha_hash") @db.VarChar(255)
  updatedAt           DateTime @updatedAt @map("atualizado_em")

  @@map("configuracoes_sistema")
}

model Sessao {
  id         String         @id @db.VarChar(36)
  usuarioId  Int            @map("usuario_id")
  criadoEm   DateTime       @default(now()) @map("criado_em")
  expiraEm   DateTime       @map("expira_em")
  revogadoEm DateTime?      @map("revogado_em")
  usuario    Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokens     RefreshToken[]

  @@index([usuarioId])
  @@map("sessoes")
}

model RecuperacaoSenha {
  id          Int       @id @default(autoincrement())
  usuarioId   Int       @map("usuario_id")
  resumoToken String    @unique @map("resumo_token") @db.VarChar(64)
  criadoEm    DateTime  @default(now()) @map("criado_em")
  expiraEm    DateTime  @map("expira_em")
  usadoEm     DateTime? @map("usado_em")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("recuperacoes_senha")
}

model EventoAuditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int?     @map("usuario_id")
  acao      String   @db.VarChar(16)
  recurso   String   @db.VarChar(200)
  resultado Int
  requestId String   @map("request_id") @db.VarChar(36)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@map("eventos_auditoria")
}

model RequisicaoIdempotente {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @map("usuario_id")
  chave         String   @db.VarChar(36)
  resumoEntrada String   @map("resumo_entrada") @db.VarChar(64)
  resposta      Json?
  criadoEm      DateTime @default(now()) @map("criado_em")

  @@unique([usuarioId, chave])
  @@map("requisicoes_idempotentes")
}
