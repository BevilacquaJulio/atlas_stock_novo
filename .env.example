PROJECT=atlas
# Botão público de demonstração: habilite somente em uma instalação de demonstração.
VITE_DEMO_MODE=false
# Credencial pública exclusiva da demonstração, com pelo menos 12 caracteres.
VITE_DEMO_PASSWORD=
# ─────────────────────────────────────────────────────────────────────
# .env RAIZ (Docker) — Atlas Stock
# Copie para `.env` e preencha. NUNCA comite o `.env` real.
# Este arquivo alimenta tanto a interpolacao do docker-compose (DOMAIN,
# TRAEFIK_*) quanto as variáveis explícitas dos serviços de produção.
# ─────────────────────────────────────────────────────────────────────

# ─── Dominio publico (Traefik) ───
# Frontend em https://${DOMAIN} ; API em https://api.${DOMAIN}
DOMAIN=g5.seudominio.com.br
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# ─── Aplicacao ───
NODE_ENV=production
PORT=3000

# ─── Banco MySQL compartilhado ───
# MYSQL_HOST = nome do container MySQL na rede mysql_shared (NUNCA localhost).
# O banco e a conta precisam existir ANTES do primeiro deploy.
# A mesma conta atende a API e as migrations, com permissões neste banco.
MYSQL_HOST=mysql_shared
MYSQL_PORT=3306
MYSQL_USER=atlas_app
MYSQL_PASSWORD=troque_esta_senha
MYSQL_DATABASE=atlas_estoque
# O MySQL 8.4 exige transporte seguro na autenticacao SHA-2 completa.
MYSQL_SSL=true
# false aceita o certificado autoassinado do MySQL na rede Docker privada.
MYSQL_SSL_REJECT_UNAUTHORIZED=false
MYSQL_SSL_CA_PATH=/run/secrets/mysql-ca.pem

# ─── Access JWT e refresh opaco ───
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=604800
# Secure automático em produção; false apenas no Docker .localhost.
# COOKIE_SECURE=false
# Informe somente IPs/CIDRs reais dos proxies; vazio ignora X-Forwarded-For.
TRUST_PROXY=

# ─── Seguranca ───
# CORS deve bater com a origem publica do frontend.
CORS_ORIGIN=https://g5.seudominio.com.br
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ─── Seed (obrigatorio apenas ao executar o seed inicial) ───
SEED_ADMIN_EMAIL=admin@atlas.com
SEED_ADMIN_PASSWORD=
