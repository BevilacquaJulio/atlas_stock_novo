# ─── Aplicação ───
NODE_ENV=development
PORT=3000

# ─── Banco de dados MySQL ───
# A URL de conexão é montada a partir destas variáveis (ver src/config/database-url.ts).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=atlas_estoque
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_SSL_CA_PATH=

# ─── Access JWT e refresh opaco ───
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=604800
# Gere 32 bytes em hexadecimal; conserve a chave para ler MFA e backups.
MFA_ENCRYPTION_KEY=
# Secure automático em produção; false apenas no Docker .localhost.
# COOKIE_SECURE=false
# Informe somente IPs/CIDRs reais dos proxies; vazio ignora X-Forwarded-For.
TRUST_PROXY=

# ─── Segurança ───
CORS_ORIGIN=http://localhost:5173
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ─── Seed (obrigatório apenas ao executar o seed inicial) ───
SEED_ADMIN_EMAIL=admin@atlas.com
SEED_ADMIN_PASSWORD=

# Somente em banco exclusivo de demonstração; produção é bloqueada.
ALLOW_DEMO_POPULATE=false

# Ative após cadastrar MFA nas contas privilegiadas.
REQUIRE_PRIVILEGED_MFA=false
